// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum GameStatus {
  PLAYING
  COMPLETED
  DROPPED
}

enum GamingPlatform {
  STEAM
  PLAYSTATION
  XBOX
  NINTENDO
  GOG
  EPIC_GAMES
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model User {
  userId                 String             @id @default(uuid()) @db.Uuid
  username               String             @unique
  email                  String             @unique
  passwordHash           String             @unique
  profilePicture         String?
  role                   UserRole           @default(USER)
  gameLibraryEntries     GameLibraryEntry[]
  platformAccounts       PlatformAccount[]
  guides                 Guide[]
  report                 Report[]
  discussions            Discussion[]
  sentFriendRequests     Friendship[]       @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]       @relation("FriendshipRecipient")

  @@map("users")
}

model Game {
  gameId             String             @id @default(uuid()) @db.Uuid
  title              String
  releaseYear        Int?
  guides             Guide[]
  discussions        Discussion[]
  gameLibraryEntries GameLibraryEntry[]

  @@map("games")
}

model GameLibraryEntry {
  gameLibraryEntryId String     @id @default(uuid()) @db.Uuid
  userId             String     @db.Uuid
  gameId             String     @db.Uuid
  status             GameStatus
  rating             Int?
  startDate          DateTime?
  completionDate     DateTime?

  user   User    @relation(fields: [userId], references: [userId])
  game   Game    @relation(fields: [gameId], references: [gameId])
  review Review?

  @@unique([userId, gameId])
  @@map("game_library_entries")
}

model Review {
  reviewId           String   @id @default(uuid()) @db.Uuid
  gameLibraryEntryId String   @unique @db.Uuid
  content            String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  gameLibraryEntry GameLibraryEntry @relation(fields: [gameLibraryEntryId], references: [gameLibraryEntryId])

  @@map("reviews")
}

model PlatformAccount {
  platformAccountId String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  platform          GamingPlatform
  identifier        String
  isVisible         Boolean        @default(true)

  user User @relation(fields: [userId], references: [userId])

  @@unique([userId, platform])
  @@map("platform_accounts")
}

model Friendship {
  friendship  String           @id @default(uuid()) @db.Uuid
  requesterId String           @db.Uuid
  recipientId String           @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [userId])
  recipient User @relation("FriendshipRecipient", fields: [recipientId], references: [userId])

  @@unique([requesterId, recipientId])
  @@map("friendship")
}

model Guide {
  guideId   String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  gameId    String   @db.Uuid
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report Report[]

  user User @relation(fields: [userId], references: [userId])
  game Game @relation(fields: [gameId], references: [gameId])

  @@map("guides")
}

model Discussion {
  discussionId String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  gameId       String   @db.Uuid
  title        String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  report Report[]

  user User @relation(fields: [userId], references: [userId])
  game Game @relation(fields: [gameId], references: [gameId])

  @@map("discussions")
}

model Report {
  reportId     String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  discussionId String?      @db.Uuid
  guideId      String?      @db.Uuid
  reason       String
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())

  user       User        @relation(fields: [userId], references: [userId])
  discussion Discussion? @relation(fields: [discussionId], references: [discussionId])
  guide      Guide?      @relation(fields: [guideId], references: [guideId])

  @@map("reports")
}
