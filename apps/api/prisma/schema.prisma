// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum GameStatus {
  PLAYING
  COMPLETED
  DROPPED
}

enum GamingPlatform {
  STEAM
  PLAYSTATION
  XBOX
  NINTENDO
  GOG
  EPIC_GAMES
}

model User {
  userId             String             @id @default(uuid()) @db.Uuid
  username           String             @unique
  email              String             @unique
  passwordHash       String             @unique
  profilePicture     String?
  role               UserRole           @default(USER)
  gameLibraryEntries GameLibraryEntry[]
  platformAccounts   PlatformAccount[]

  @@map("users")
}

model Game {
  gameId      String @id @default(uuid()) @db.Uuid
  title       String
  releaseYear Int?

  gameLibraryEntries GameLibraryEntry[]

  @@map("games")
}

model GameLibraryEntry {
  gameLibraryEntryId String     @id @default(uuid()) @db.Uuid
  userId             String     @db.Uuid
  gameId             String     @db.Uuid
  status             GameStatus
  rating             Int?
  startDate          DateTime?
  completionDate     DateTime?

  user   User    @relation(fields: [userId], references: [userId])
  game   Game    @relation(fields: [gameId], references: [gameId])
  review Review?

  @@unique([userId, gameId])
  @@map("game_library_entries")
}

model Review {
  reviewId           String   @id @default(uuid()) @db.Uuid
  gameLibraryEntryId String   @unique @db.Uuid
  content            String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  gameLibraryEntry GameLibraryEntry @relation(fields: [gameLibraryEntryId], references: [gameLibraryEntryId])

  @@map("reviews")
}

model PlatformAccount {
  platformAccountId String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  platform          GamingPlatform
  identifier        String
  isVisible         Boolean        @default(true)

  user User @relation(fields: [userId], references: [userId])

  @@unique([userId, platform])
  @@map("platform_accounts")
}
